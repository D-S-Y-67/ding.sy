# ---------------------------------------------------------------------------
# Regmaglypt environment variables
# Copy to .env.local for local development. Never commit real values.
# Full setup walkthrough for every service: SETUP.md
# ---------------------------------------------------------------------------

# --- Core -----------------------------------------------------------------

# Absolute base URL of THIS app. Local dev: http://localhost:3000
# Production: https://<your-vercel-domain> (later: https://regmaglypt.com)
# Used as the auth base URL and as the JWT issuer.
BETTER_AUTH_URL=http://localhost:3000

# Secret for hashing/encryption inside Better Auth (session tokens, private
# key encryption). Generate one:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Database ---------------------------------------------------------------

# Postgres connection string (Supabase project, ap-southeast-1).
# Use the "Transaction pooler" URL (port 6543) on Vercel; add ?sslmode=require.
# Example:
# postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# --- Microsoft OAuth (Entra ID) --------------------------------------------

# From the Azure portal (see SETUP.md §1). Optional in dev: without them
# the Microsoft button renders but sign-in reports an error.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional. Default "common" allows personal + work/school accounts;
# set a directory (tenant) ID to restrict sign-in to one organisation.
MICROSOFT_TENANT_ID=

# --- Email (magic links) ----------------------------------------------------

# From Resend (see SETUP.md §2). Optional in dev: when unset, magic links
# are printed to the dev-server console instead of being emailed.
RESEND_API_KEY=

# Verified sender, e.g.  Regmaglypt <signin@mail.regmaglypt.com>
# Falls back to Resend's onboarding sender when unset (dev only).
EMAIL_FROM=
